# Default settings for docker-compose
# @see https://docs.docker.com/compose/reference/envvars/#compose_file
COMPOSE_PROJECT_NAME=task-management

# build
PHP_VERSION=8.3
NODE_VERSION=22

MYSQL_VERSION=8
MYSQL_DATABASE=dev
MYSQL_ROOT_PASSWORD=dev
MYSQL_USER=dev
MYSQL_PASSWORD=dev

# app
APP_HOST=task-management.test
